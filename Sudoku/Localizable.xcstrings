    "Some cells outside the chain see a cell of each color. Whichever color holds %lld, they see it, so they can't be %lld.": {
      "comment": "Hint walkthrough page: Simple Coloring, color trap",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some cells outside the chain see a cell of each color. Whichever color holds %1$lld, they see it, so they can't be %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zincirin dışındaki bazı hücreler her iki renkten birer hücre görüyor. %1$lld hangi renkte olursa olsun onu görürler; bu yüzden %2$lld olamazlar."
          }
        }
      }
    },
    "Some digits on the board are incorrect. Fix them before looking for the next step.": {
      "comment": "Hint message when the board has wrong digits",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some digits on the board are incorrect. Fix them before looking for the next step."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahtadaki bazı rakamlar hatalı. Sonraki adıma geçmeden önce bunları düzelt."
          }
        }
      }
