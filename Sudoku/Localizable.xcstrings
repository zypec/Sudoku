            "state": "translated",
            "value": "Kolay"
          }
        }
      }
    },
    "Either way one of these two cells is %lld, so a cell that sees both can't be %lld.": {
      "comment": "Hint walkthrough page: XY-Wing, conclusion",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way one of these two cells is %1$lld, so a cell that sees both can't be %2$lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her durumda bu iki hücreden biri %1$lld olur; ikisini birden gören bir hücre %2$lld olamaz."
          }
        }
      }
    },
