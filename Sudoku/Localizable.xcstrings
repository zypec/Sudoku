            "state": "translated",
            "value": "Two colors along strong links"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basit Boyama"
          }
        }
      }
    },
    "Two digits, two cells": {
      "comment": "Subtitle for the Hidden Pair technique",
      "localizations": {
        "en": {
