          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birbirinden uzak, aynı iki notu taşıyan iki hücre bul, sonra rakamlarından birinin yalnızca iki yeri olduğu ve her yerin bu hücrelerden birine yakın olduğu bir birim ara."
          }
        }
      }
    },
