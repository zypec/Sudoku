{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@": {
      "comment": "Saved game summary under Continue: difficulty and elapsed time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld remaining": {
      "comment": "Accessibility value of a number pad key: how many of this digit are still missing",
