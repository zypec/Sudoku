        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki notlu hücrelere ve fazladan bir adayı olan küçük hücre gruplarına, ikisinde de bulunan bir rakamla bağlanmış olanlara bak."
          }
        }
      }
    },
